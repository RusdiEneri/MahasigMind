# --- Laravel Core ---
/vendor/
/bootstrap/ssr/
/storage/*.key
/*.laravel-sheet
.phpunit.result.cache
/.phpunit.cache/

# --- Database & Logs ---
*.log
*.sqlite
/storage/app/*.sqlite
*.cache
*.pid

# --- Storage Framework & Logs (Keep .gitignore files) ---
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# --- Node & Frontend Build Tools ---
/node_modules/
/public/build/
/public/hot/
/public/storage
/.vite/
/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment & Sensitive Data (P0 Security) ---
.env
.env.backup
.env.*
!.env.example
auth.json
Homestead.json
Homestead.yaml

# --- IDE & OS Configurations ---
.vscode/
.idea/
/.fleet/
.DS_Store
Thumbs.db
.phpstorm.meta.php
_ide_helper*.php
.php_cs.cache